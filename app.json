{
  "expo": {
    "name": "rmas-fitnex_2022_0387",
    "slug": "rmas-fitnex_2022_0387",
    "scheme": "rmas-fitnex_2022_0387",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Fitnex requires Face ID access to log you in quickly and securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_KEY}"
        }
      },
      "package": "com.fitnex.app"
    },
    "web": {
      "favicon": "./assets/LOGO 1.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitnex to access your camera to scan barcodes."
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Fitnex to access your motion data to count steps."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fitnex to use your location to find nearby gyms."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5698e6e9-33c2-4062-b696-39ad8a4e95e9"
      }
    }
  }
}
